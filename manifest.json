{
"name": "J-Eye — Image to Text & Markdown",
"short_name": "J-Eye",
"description": "Convert images, notes, tables, and code into formatted Text, Markdown, Word Docs, and PDF with exact text color preservation.",
"start_url": "./index.html",
"scope": "./",
"display": "standalone",
"orientation": "any",
"background_color": "#0f172a",
"theme_color": "#4f46e5",
"categories": ["productivity", "utilities", "education"],
"icons": [
{
"src": "./icon-192.png",
"sizes": "192x192",
"type": "image/png",
"purpose": "any maskable"
},
{
"src": "./icon-512.png",
"sizes": "512x512",
"type": "image/png",
"purpose": "any maskable"
},
{
"src": "./icon.svg",
"sizes": "any",
"type": "image/svg+xml",
"purpose": "any"
}
],
"share_target": {
"action": "./index.html",
"method": "POST",
"enctype": "multipart/form-data",
"params": {
"files": [
{
"name": "image",
"accept": ["image/*"]
}
]
}
}
}
